{
  "manifest_version": 3,
  "name": "Gemini Station",
  "version": "1.4",
  "description": "Native Context Menu & New Tab Redirect",
  "icons": { "48": "icon.png" },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}